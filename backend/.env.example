# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
# Replace with your MongoDB connection string (e.g. mongodb+srv://...)
MONGO_URI=mongodb://localhost:27017/aiRender

# ─── JWT ──────────────────────────────────────────────────
# Secret key used to sign JSON Web Tokens
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── Google OAuth (For Native Google Sign-In verification) ──
# Web Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# ─── WebAuthn / Passkeys (Android Credential Manager) ─────
WEBAUTHN_RP_NAME=aiRender
# For local Android emulator, set RP_ID to 10.0.2.2 (which maps to host machine)
WEBAUTHN_RP_ID=10.0.2.2
# Origin verification fallback
WEBAUTHN_ORIGIN=http://10.0.2.2:5000

# ─── Brevo Email API (For meeting reminders/emails) ───────
BREVO_API_KEY=your_brevo_api_key_here
SMTP_USER=ayush.airender@gmail.com

# ─── JaaS (Jitsi as a Service - Option for meetings) ──────
JAAS_APP_ID=your_jaas_app_id
JAAS_API_KEY_ID=your_jaas_api_key_id

# ─── Firebase Cloud Messaging (For Mobile Push Login) ─────
# Single-line JSON service account from Firebase Console
FIREBASE_SERVICE_ACCOUNT={"type": "service_account", ...}

# ─── Android SHA-256 (For Native Passkeys verification) ────
# Keystore signature fingerprint (exclude colons)
ANDROID_SHA256=your_android_app_sha256_cert_fingerprint
