{
  "name": "auth-showcase",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "cd backend && npm install --legacy-peer-deps && cd ../mobile && npm install --legacy-peer-deps",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:mobile\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:mobile": "cd mobile && npm run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
